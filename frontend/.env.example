# KisanLink Frontend Environment Configuration Template
# Copy this file to .env.development or .env.production and set the appropriate variables.

# Core Backend API Base URL
# Leave empty for local Vite development; /api requests use the Vite proxy.
VITE_API_URL=

# AI Vision Microservice Base URL (FastAPI)
VITE_AI_API_URL=http://localhost:8000

# WebSocket Broker URL (Optional fallback derived from VITE_API_URL)
VITE_WS_URL=ws://localhost:8080/ws-connect

# Demo Mode — enables 1-click login and demo data (Review 5 fix: must be 'false' in production)
# Set to 'true' only for development/demo environments.
# When absent or set to anything other than 'true', demo login is hidden and disabled.
VITE_DEMO_MODE=true

# Production Example:
# VITE_API_URL=https://api.kisanlink.org
# VITE_AI_API_URL=https://ai.kisanlink.org
# VITE_WS_URL=wss://api.kisanlink.org/ws-connect
# VITE_DEMO_MODE=false
