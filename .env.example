# ─────────────────────────────────────────────────────────────────────────────
# KisanLink Production Environment Configuration Template
# Copy this file to .env before starting containers:
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL Database Configuration
POSTGRES_DB=kisanlink
POSTGRES_USER=kisanlink_admin
# Required: Set a strong random password for production
POSTGRES_PASSWORD=replace_with_strong_database_password_32chars

# Security & Authentication
# Required: Minimum 256-bit cryptographic secret for HMAC-SHA256 JWT signing
JWT_SECRET=replace_with_minimum_32_character_cryptographically_secure_jwt_secret
JWT_EXPIRATION=86400000

# Payment Gateway Webhook Secret
KISANLINK_PAYMENT_WEBHOOK_SECRET=replace_with_razorpay_or_cashfree_webhook_secret

# AI Service Configuration
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# Frontend URLs
VITE_API_URL=http://localhost:8080
VITE_AI_API_URL=http://localhost:8000
